{%- comment -%}
  Accepts: card_product, kicker (optional string)

  Supplier product titles run long, so the title is clamped to two lines by CSS
  and the type of thing it is sits above it as a small kicker.
{%- endcomment -%}

{%- liquid
  assign p = card_product
  assign on_sale = false
  if p.compare_at_price > p.price
    assign on_sale = true
  endif
  assign card_kicker = kicker | default: p.type
-%}

<div class="pcard">
  <div class="pcard__media">
    <div class="pcard__frame">
    {%- if p.featured_media -%}
      <img class="pcard__img--main"
        src="{{ p.featured_media | image_url: width: 700 }}"
        srcset="{{ p.featured_media | image_url: width: 350 }} 350w, {{ p.featured_media | image_url: width: 700 }} 700w, {{ p.featured_media | image_url: width: 1000 }} 1000w"
        sizes="(min-width: 1100px) 300px, (min-width: 750px) 30vw, 62vw"
        alt="{{ p.featured_media.alt | default: p.title | escape }}"
        width="{{ p.featured_media.width }}"
        height="{{ p.featured_media.height }}"
        loading="lazy">
      {%- if p.media[1] -%}
        <img class="pcard__img--alt"
          src="{{ p.media[1] | image_url: width: 700 }}"
          alt=""
          width="{{ p.media[1].width }}"
          height="{{ p.media[1].height }}"
          loading="lazy"
          aria-hidden="true">
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    </div>

    {%- if on_sale -%}
      <span class="tag tag--accent pcard__flag">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif p.available == false -%}
      <span class="tag tag--ghost pcard__flag">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif p.tags contains 'new' -%}
      <span class="tag tag--ghost pcard__flag">{{ 'products.product.new' | t }}</span>
    {%- endif -%}
  </div>

  <div class="pcard__body">
    {%- if card_kicker != blank -%}
      <p class="pcard__kicker">{{ card_kicker }}</p>
    {%- endif -%}
    <h3 class="pcard__title"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
    <div class="pcard__price">
      {%- if on_sale -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
      {%- if p.price_varies -%}
        {{ 'products.product.from_price' | t: price: p.price_min | money }}
      {%- else -%}
        {{ p.price | money }}
      {%- endif -%}
    </div>
  </div>
</div>
