<div class="drawer drawer--right" id="cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
  <div class="drawer__scrim"></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <span class="drawer__title">{{ 'sections.cart.title' | t }}</span>
      <button class="icon-btn" type="button" data-drawer-close data-drawer-focus aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    {% render 'cart-drawer-contents' %}
  </div>
</div>
