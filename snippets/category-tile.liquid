{%- comment -%}
  One category tile. Uses the collection's own image when there is one, and
  falls back to the hand-drawn illustration for that category.

  Accepts: cat_collection, art, label (optional), show_count (bool)
{%- endcomment -%}
{%- liquid
  assign coll = cat_collection
  assign name = label | default: coll.title
-%}
<a class="cat" href="{{ coll.url | default: routes.all_products_collection_url }}">
  <span class="cat__art{% if coll.featured_image %} cat__art--photo{% endif %}">
    {%- if coll.featured_image -%}
      <img src="{{ coll.featured_image | image_url: width: 400 }}"
           alt="" width="200" height="200" loading="lazy">
    {%- else -%}
      {% render 'category-art', art: art %}
    {%- endif -%}
  </span>
  <span class="cat__name">{{ name }}</span>
  {%- if show_count and coll != blank -%}
    <span class="cat__count">{{ 'sections.collection.count' | t: count: coll.products_count }}</span>
  {%- endif -%}
</a>
