{%- comment -%}
  The wordmark. Text set in the display serif rather than an image file, so it
  stays sharp at any size, follows the theme's typography settings and remains
  real, selectable text for search engines and screen readers.

  Beside it sits the season number — a small tracked marker that quietly dates
  the shop and changes on its own each quarter.

  Accepts: size (px, optional), tag ('div' to avoid nesting links)
{%- endcomment -%}

{%- liquid
  assign logo_text = settings.logo_text | default: shop.name
  assign season_no = settings.season_number
  assign show_season = settings.logo_show_season
-%}

{%- capture logo_inner -%}
  <span class="logo__word">{{ logo_text }}</span>
  {%- if show_season and season_no != blank -%}
    <span class="logo__season" aria-hidden="true">{{ season_no }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- assign logo_style_attr = '' -%}
{%- if size -%}
  {%- assign logo_style_attr = 'style="--logo-size:' | append: size | append: 'px"' -%}
{%- endif -%}

{%- if tag == 'div' -%}
  <div class="logo" {{ logo_style_attr }}>{{ logo_inner }}</div>
{%- else -%}
  <a class="logo" href="{{ routes.root_url }}" {{ logo_style_attr }}>{{ logo_inner }}</a>
{%- endif -%}
