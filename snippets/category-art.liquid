{%- comment -%}
  Hand-drawn category illustrations, inline so they recolour with the theme
  and stay crisp at any size. Every one is drawn on a 100 × 100 grid with the
  same 4px black outline, so the ten of them read as one set.

  Accepts: art (string) — duck, mushroom, frog, snail, bee, cat, bear,
                          strawberry, moon, snack
{%- endcomment -%}

<svg class="cat-art" viewBox="0 0 100 100" role="img" aria-hidden="true" focusable="false"
     stroke="var(--ink)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
  {%- case art -%}

    {%- when 'duck' -%}
      <ellipse cx="55" cy="64" rx="30" ry="22" fill="var(--yellow-deep)"/>
      <path d="M74 52c8 4 11 10 11 14" fill="none"/>
      <circle cx="33" cy="38" r="17" fill="var(--yellow-deep)"/>
      <path d="M17 36 6 42l11 6z" fill="var(--pink-deep)"/>
      <circle cx="31" cy="33" r="2.6" fill="var(--ink)" stroke="none"/>
      <path d="M48 62c6 8 16 10 24 6" fill="none"/>
      <path d="M22 86h56" fill="none" stroke-dasharray="10 8"/>

    {%- when 'mushroom' -%}
      <path d="M52 50h-8a10 10 0 0 0-10 10v18a8 8 0 0 0 8 8h12a8 8 0 0 0 8-8V60a10 10 0 0 0-10-10z" fill="var(--cream)"/>
      <path d="M16 52a34 30 0 0 1 68 0z" fill="var(--pink-deep)"/>
      <circle cx="34" cy="38" r="6" fill="var(--cream)"/>
      <circle cx="58" cy="32" r="4.5" fill="var(--cream)"/>
      <circle cx="70" cy="44" r="4" fill="var(--cream)"/>
      <circle cx="43" cy="66" r="2.2" fill="var(--ink)" stroke="none"/>
      <circle cx="57" cy="66" r="2.2" fill="var(--ink)" stroke="none"/>
      <path d="M45 73c3 3 7 3 10 0" fill="none"/>

    {%- when 'frog' -%}
      <ellipse cx="50" cy="62" rx="32" ry="24" fill="var(--green-deep)"/>
      <circle cx="32" cy="34" r="13" fill="var(--green-deep)"/>
      <circle cx="68" cy="34" r="13" fill="var(--green-deep)"/>
      <circle cx="32" cy="34" r="6" fill="var(--bg)"/>
      <circle cx="68" cy="34" r="6" fill="var(--bg)"/>
      <circle cx="33" cy="35" r="2.8" fill="var(--ink)" stroke="none"/>
      <circle cx="69" cy="35" r="2.8" fill="var(--ink)" stroke="none"/>
      <path d="M34 64c9 9 23 9 32 0" fill="none"/>
      <path d="M22 82c-4 4-4 8 0 8M78 82c4 4 4 8 0 8" fill="none"/>

    {%- when 'snail' -%}
      <path d="M12 80c0-14 10-22 24-22h26v22z" fill="var(--green-deep)"/>
      <circle cx="60" cy="48" r="26" fill="var(--pink-deep)"/>
      <path d="M60 34a14 14 0 1 1-13 20" fill="none"/>
      <path d="M22 58V44M32 58V38" fill="none"/>
      <circle cx="22" cy="41" r="3.4" fill="var(--ink)" stroke="none"/>
      <circle cx="32" cy="35" r="3.4" fill="var(--ink)" stroke="none"/>
      <circle cx="26" cy="66" r="2.2" fill="var(--ink)" stroke="none"/>
      <path d="M30 72c3 2 6 2 8 0" fill="none"/>

    {%- when 'bee' -%}
      <ellipse cx="50" cy="34" rx="13" ry="9" transform="rotate(-24 50 34)" fill="var(--cream)"/>
      <ellipse cx="50" cy="34" rx="13" ry="9" transform="rotate(24 50 34)" fill="var(--cream)"/>
      <ellipse cx="50" cy="60" rx="26" ry="21" fill="var(--yellow-deep)"/>
      {%- comment -%} Stripes are cut to follow the body's curve, so no clip path is needed. {%- endcomment -%}
      <path d="M42 40q4.5-1 9-.8v41.6q-4.5.2-9-.8z" fill="var(--ink)" stroke="none"/>
      <path d="M60 40.6q4.5 1.4 9 5.1v28.6q-4.5 3.7-9 5.1z" fill="var(--ink)" stroke="none"/>
      <ellipse cx="50" cy="60" rx="26" ry="21" fill="none"/>
      <path d="M42 26l-6-10M58 26l6-10" fill="none"/>
      <circle cx="34" cy="13" r="3.2" fill="var(--ink)" stroke="none"/>
      <circle cx="66" cy="13" r="3.2" fill="var(--ink)" stroke="none"/>
      <circle cx="35" cy="57" r="2.4" fill="var(--ink)" stroke="none"/>
      <path d="M31 65c3 3 7 3 10 0" fill="none"/>

    {%- when 'cat' -%}
      <path d="M24 42 22 16l22 12zM76 42 78 16 56 28z" fill="var(--pink)"/>
      <circle cx="50" cy="58" r="28" fill="var(--pink)"/>
      <path d="M34 52c3-4 8-4 11 0M55 52c3-4 8-4 11 0" fill="none"/>
      <path d="M46 64h8l-4 4z" fill="var(--pink-deep)"/>
      <path d="M50 68v3M50 71c-3 3-7 2-8-1M50 71c3 3 7 2 8-1" fill="none"/>
      <path d="M12 58h14M14 68l12-3M88 58H74M86 68l-12-3" fill="none"/>

    {%- when 'bear' -%}
      <circle cx="26" cy="30" r="13" fill="var(--yellow)"/>
      <circle cx="74" cy="30" r="13" fill="var(--yellow)"/>
      <circle cx="26" cy="30" r="6" fill="var(--pink)"/>
      <circle cx="74" cy="30" r="6" fill="var(--pink)"/>
      <circle cx="50" cy="58" r="29" fill="var(--yellow)"/>
      <ellipse cx="50" cy="68" rx="16" ry="12" fill="var(--cream)"/>
      <ellipse cx="50" cy="62" rx="5" ry="3.6" fill="var(--ink)" stroke="none"/>
      <path d="M50 66v3M50 69c-3 3-6 2-7 0M50 69c3 3 6 2 7 0" fill="none"/>
      <circle cx="37" cy="50" r="2.6" fill="var(--ink)" stroke="none"/>
      <circle cx="63" cy="50" r="2.6" fill="var(--ink)" stroke="none"/>

    {%- when 'strawberry' -%}
      <path d="M50 90c-17 0-30-16-30-33 0-12 13-19 30-19s30 7 30 19c0 17-13 33-30 33z" fill="var(--pink-deep)"/>
      <path d="M50 12v18M50 30 32 22l4 12zM50 30l18-8-4 12z" fill="var(--green-deep)"/>
      <g fill="var(--yellow)" stroke="none">
        <ellipse cx="38" cy="52" rx="2.6" ry="3.6"/><ellipse cx="62" cy="52" rx="2.6" ry="3.6"/>
        <ellipse cx="50" cy="62" rx="2.6" ry="3.6"/><ellipse cx="33" cy="66" rx="2.6" ry="3.6"/>
        <ellipse cx="67" cy="66" rx="2.6" ry="3.6"/><ellipse cx="50" cy="80" rx="2.6" ry="3.6"/>
      </g>
      <path d="M40 68c5 5 15 5 20 0" fill="none"/>

    {%- when 'moon' -%}
      {%- comment -%}
        A real crescent: the arc back is a second circle of the same radius
        offset to the right, so the shape has body to put a face on.
      {%- endcomment -%}
      <path d="M58 20.3A32 32 0 1 0 58 79.7 32 32 0 0 1 58 20.3z" fill="var(--yellow-deep)"/>
      <path d="M18 45c3-3 7-3 10 0M31 44c2.5-2.5 6-2.5 8.5 0" fill="none"/>
      <path d="M22 58c4 4 9 4 13 0" fill="none"/>
      <path d="M78 18l3.5 8 8 3.5-8 3.5-3.5 8-3.5-8-8-3.5 8-3.5zM72 64l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="var(--pink-deep)"/>

    {%- when 'snack' -%}
      {%- comment -%}
        A slice of toast. The dome is a shallow arc on tall straight sides —
        a full semicircle reads as an arch, not as bread.
      {%- endcomment -%}
      <path d="M18 78V48a38 38 0 0 1 64 0v30a6 6 0 0 1-6 6H24a6 6 0 0 1-6-6z" fill="var(--yellow-deep)"/>
      <path d="M26 74V52a30 30 0 0 1 48 0v22a4 4 0 0 1-4 4H30a4 4 0 0 1-4-4z" fill="var(--cream)"/>
      <path d="M46 46l9-4 4 9-9 4z" fill="var(--yellow-deep)"/>
      <circle cx="42" cy="64" r="2.6" fill="var(--ink)" stroke="none"/>
      <circle cx="58" cy="64" r="2.6" fill="var(--ink)" stroke="none"/>
      <path d="M45 70c4 4 6 4 10 0" fill="none"/>

    {%- else -%}
      <circle cx="50" cy="50" r="32" fill="var(--cream)"/>
      <circle cx="40" cy="44" r="2.8" fill="var(--ink)" stroke="none"/>
      <circle cx="60" cy="44" r="2.8" fill="var(--ink)" stroke="none"/>
      <path d="M40 60c6 6 14 6 20 0" fill="none"/>
  {%- endcase -%}
</svg>
