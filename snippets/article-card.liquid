{%- comment -%} Accepts: article {%- endcomment -%}
<article class="acard">
  <div class="acard__media">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 900 }}"
        srcset="{{ article.image | image_url: width: 450 }} 450w, {{ article.image | image_url: width: 900 }} 900w, {{ article.image | image_url: width: 1300 }} 1300w"
        sizes="(min-width: 1100px) 400px, (min-width: 750px) 45vw, 92vw"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="{{ article.image.width }}" height="{{ article.image.height }}"
        loading="lazy">
    {%- else -%}
      <span class="motif">{% render 'season-motif' %}</span>
    {%- endif -%}
  </div>
  <div class="acard__body">
    <p class="acard__meta">
      {{ article.published_at | date: format: 'date' }}
      {%- if article.tags.size > 0 %} &middot; {{ article.tags.first }}{% endif -%}
    </p>
    <h3 class="acard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
    <p class="acard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
    <p class="acard__more">{{ 'blogs.article.read' | t }}</p>
  </div>
</article>
