{%- comment -%} Accepts: article {%- endcomment -%}
<article class="acard">
  <div class="acard__media">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 800 }}"
        srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w"
        sizes="(min-width: 990px) 380px, (min-width: 750px) 45vw, 90vw"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="{{ article.image.width }}" height="{{ article.image.height }}"
        loading="lazy">
    {%- else -%}
      {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="acard__body">
    <h3 class="acard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
    <p class="acard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
    <p class="acard__meta">
      {{ article.published_at | date: format: 'date' }}
      {%- if article.tags.size > 0 %} &middot; {{ article.tags.first }}{% endif -%}
    </p>
  </div>
</article>
