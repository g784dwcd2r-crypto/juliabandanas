{%- comment -%}
  The season motif — one line drawing, used as the ornament for the current
  quarter. Every motif is drawn on the same 64 × 64 grid with the same 1.4px
  stroke and no fill, so swapping the season swaps the drawing without
  changing the weight or scale of anything around it.

  Accepts: motif (string). Falls back to the theme's season motif setting.

  To add a motif: add a `when` branch here, then add the same value to the
  `season_motif` select in config/settings_schema.json.
{%- endcomment -%}

{%- liquid
  assign m = motif | default: settings.season_motif | default: 'duck'
-%}

<span class="motif__art" aria-hidden="true">
<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {%- case m -%}

    {%- when 'duck' -%}
      <path d="M8.5 34.5c0-4 4-7 9.5-7h10c0-6 3.5-11 9-12.5"/>
      <circle cx="42.5" cy="16.5" r="8"/>
      <path d="M50.5 14.5h7.5c.9 0 1.4 1 .9 1.7l-2.6 3.4c-.4.5-1 .8-1.6.8h-4.2"/>
      <circle cx="45.5" cy="14.5" r="1.2" fill="currentColor" stroke="none"/>
      <path d="M34.5 27.5c5 1.5 8.5 5 9.5 9"/>
      <path d="M8.5 34.5c1 8.5 9 15 18.5 15s17.5-6.5 18.5-15"/>
      <path d="M18 34.5c1.5 4.5 5 7.5 9.5 8.5"/>
      <path d="M5 55.5h18M29 55.5h30"/>

    {%- when 'leaf' -%}
