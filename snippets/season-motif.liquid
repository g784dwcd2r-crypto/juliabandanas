      <path d="M26 33.5v13.5c0 3.3 2.7 6 6 6s6-2.7 6-6V33.5"/>
      <circle cx="23" cy="23" r="3.5"/>
      <circle cx="40" cy="20.5" r="2.5"/>
      <circle cx="33" cy="27.5" r="2"/>

    {%- when 'star' -%}
