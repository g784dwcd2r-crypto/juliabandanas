      <path d="M32.0 16.0L37.7 7.8M32.0 16.0L26.3 7.8M32.0 23.0L36.0 17.3M32.0 23.0L28.0 17.3M45.9 24.0L55.8 24.9M45.9 24.0L50.1 14.9M39.8 27.5L46.8 28.1M39.8 27.5L42.8 21.2M45.9 40.0L50.1 49.1M45.9 40.0L55.8 39.1M39.8 36.5L42.8 42.8M39.8 36.5L46.8 35.9M32.0 48.0L26.3 56.2M32.0 48.0L37.7 56.2M32.0 41.0L28.0 46.7M32.0 41.0L36.0 46.7M18.1 40.0L8.2 39.1M18.1 40.0L13.9 49.1M24.2 36.5L17.2 35.9M24.2 36.5L21.2 42.8M18.1 24.0L13.9 14.9M18.1 24.0L8.2 24.9M24.2 27.5L21.2 21.2M24.2 27.5L17.2 28.1"/>
