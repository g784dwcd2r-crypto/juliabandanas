[
  {
    "name": "theme_info",
    "theme_name": "Julia Mind",
    "theme_version": "2.0.0",
    "theme_author": "Julia Mind",
    "theme_documentation_url": "https://github.com/g784dwcd2r-crypto/juliabandanas",
    "theme_support_url": "https://github.com/g784dwcd2r-crypto/juliabandanas"
  },
  {
    "name": "Season",
    "settings": [
      {
        "type": "paragraph",
        "content": "The shop runs on a season at a time. Everything below re-skins the whole site — header, home page, collection tiles, journal and footer — so a new quarter needs no code."
      },
      {
        "type": "text",
        "id": "season_number",
        "label": "Season number",
        "default": "01",
        "info": "Shown beside the wordmark and at the top of the home page."
      },
      {
        "type": "text",
        "id": "season_name",
        "label": "Season name",
        "default": "Ducks"
      },
      {
        "type": "text",
        "id": "season_period",
        "label": "Runs",
        "default": "Autumn — Winter 2026"
      },
      {
        "type": "select",
        "id": "season_motif",
        "label": "Motif",
        "info": "The line drawing used as the season's ornament, and as the fallback image on tiles with no photograph.",
        "options": [
          {
            "value": "duck",
            "label": "Duck"
          },
          {
            "value": "leaf",
            "label": "Leaf"
          },
          {
            "value": "mushroom",
            "label": "Mushroom"
          },
          {
            "value": "flower",
            "label": "Flower"
          },
          {
            "value": "cherry",
            "label": "Cherry"
          },
          {
            "value": "bee",
            "label": "Bee"
          },
          {
            "value": "shell",
            "label": "Shell"
          },
          {
            "value": "star",
            "label": "Star"
          },
          {
            "value": "moon",
            "label": "Moon"
          },
          {
            "value": "snowflake",
            "label": "Snowflake"
          }
        ],
        "default": "duck"
      },
      {
        "type": "header",
        "content": "Season palette"
      },
      {
        "type": "paragraph",
        "content": "Four colours used as flat fields — on bands, and behind product photography. They cycle, so no two neighbours in a grid ever match. The colour of text placed on each one is worked out automatically, so a field is never unreadable."
      },
      {
        "type": "color",
        "id": "season_c1",
        "label": "Colour 1 — the main one",
        "default": "#FFC72C",
        "info": "Carries the announcement bar and the hero."
      },
      {
        "type": "color",
        "id": "season_c2",
        "label": "Colour 2",
        "default": "#FF4D8D"
      },
      {
        "type": "color",
        "id": "season_c3",
        "label": "Colour 3",
        "default": "#1D5CE8"
      },
      {
        "type": "color",
        "id": "season_c4",
        "label": "Colour 4",
        "default": "#0F7A4F"
      },
      {
        "type": "color",
        "id": "season_mark",
        "label": "Accent text colour",
        "default": "#D6006E",
        "info": "Used for small accent text on the page background — labels, the season number, prices in a kicker. It has to stay readable at 12px, so keep it dark enough. Bright yellows and oranges will not work here."
      },
      {
        "type": "header",
        "content": "Season link"
      },
      {
        "type": "collection",
        "id": "season_collection",
        "label": "Season collection",
        "info": "Linked from the wordmark area, the announcement bar and the footer."
      },
      {
        "type": "text",
        "id": "season_link_label",
        "label": "Season link label",
        "default": "Shop the season"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Wordmark",
        "default": "Julia Mind",
        "info": "Set in the display serif. Text, not an image, so it stays sharp everywhere."
      },
      {
        "type": "checkbox",
        "id": "logo_show_season",
        "label": "Show the season number beside the wordmark",
        "default": true
      },
      {
        "type": "range",
        "id": "logo_size",
        "label": "Wordmark size",
        "min": 16,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 23
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "The ground the colour sits on. The season palette lives in the Season panel."
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Page background",
        "default": "#FFFCF2"
      },
      {
        "type": "color",
        "id": "color_paper_2",
        "label": "Quiet band",
        "default": "#FFF6DF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#111111"
      }
    ]
  },
  {
    "name": "Cards",
    "settings": [
      {
        "type": "paragraph",
        "content": "Product photos, journal images and the product gallery sit on a mat of season colour. Set this to 0 to remove it and let the photographs fill their cards. The collection tiles on the home page have their own setting, in the section itself."
      },
      {
        "type": "range",
        "id": "card_mat",
        "label": "Colour border",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "%",
        "default": 3
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "paragraph",
        "content": "The main button. Outline buttons and buttons inside a coloured band are worked out from these."
      },
      {
        "type": "color",
        "id": "btn_bg",
        "label": "Background",
        "default": "#FFC72C"
      },
      {
        "type": "color",
        "id": "btn_text",
        "label": "Text",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "btn_border",
        "label": "Border",
        "default": "#111111"
      },
      {
        "type": "header",
        "content": "On hover"
      },
      {
        "type": "color",
        "id": "btn_hover_bg",
        "label": "Background",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "btn_hover_text",
        "label": "Text",
        "default": "#FFFCF2"
      },
      {
        "type": "header",
        "content": "Behaviour"
      },
      {
        "type": "checkbox",
        "id": "btn_adaptive",
        "label": "Keep buttons readable on coloured bands",
        "default": true,
        "info": "On, a button sitting on one of the season colours falls back to black or white so it never disappears into the band. Off, your colours above are used everywhere exactly as set."
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "paragraph",
        "content": "Defaults for the collection, search and journal pages. Sections on the home page carry their own settings."
      },
      {
        "type": "header",
        "content": "Product grids"
      },
      {
        "type": "range",
        "id": "grid_cols",
        "label": "Products per row, desktop",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "select",
        "id": "grid_cols_sm",
        "label": "Products per row, phone",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          }
        ],
        "default": "2"
      },
      {
        "type": "header",
        "content": "Journal"
      },
      {
        "type": "select",
        "id": "blog_cols",
        "label": "Posts per row, desktop",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          }
        ],
        "default": "3"
      },
      {
        "type": "select",
        "id": "blog_cols_sm",
        "label": "Posts per row, phone",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          }
        ],
        "default": "1"
      },
      {
        "type": "header",
        "content": "Spacing and shape"
      },
      {
        "type": "range",
        "id": "space_scale",
        "label": "Space between sections",
        "min": 60,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner rounding",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 2,
        "info": "Applies to buttons, inputs, tags and cards. 0 is square."
      }
    ]
  },
  {
    "name": "Effects",
    "settings": [
      {
        "type": "checkbox",
        "id": "image_zoom",
        "label": "Zoom images slightly on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reveal_on_scroll",
        "label": "Fade sections in as they scroll into view",
        "default": true,
        "info": "Both are switched off automatically for visitors who ask their device to reduce motion."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fraunces for headlines, Inter for everything functional."
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base text size",
        "min": 15,
        "max": 19,
        "step": 1,
        "unit": "px",
        "default": 17
      },
      {
        "type": "range",
        "id": "type_display_weight",
        "label": "Headline weight",
        "min": 300,
        "max": 700,
        "step": 100,
        "default": 600
      },
      {
        "type": "checkbox",
        "id": "type_display_wonk",
        "label": "Let the serif's unusual letterforms through",
        "default": false,
        "info": "Off keeps the display serif conventional. On raises its WONK axis, which gives the headlines more character."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_email",
        "label": "Contact email"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open the cart in a drawer",
        "default": true
      },
      {
        "type": "richtext",
        "id": "cart_note",
        "label": "Cart note",
        "default": "<p>Shipping and any taxes are worked out at checkout. Free UK delivery over £35.</p>"
      }
    ]
  }
]
