[
  {
    "name": "theme_info",
    "theme_name": "Julia Mind",
    "theme_version": "2.0.0",
    "theme_author": "Julia Mind",
    "theme_documentation_url": "https://github.com/g784dwcd2r-crypto/juliabandanas",
    "theme_support_url": "https://github.com/g784dwcd2r-crypto/juliabandanas"
  },
  {
    "name": "Season",
    "settings": [
      {
        "type": "paragraph",
        "content": "The shop runs on a season at a time. Everything below re-skins the whole site — header, home page, collection tiles, journal and footer — so a new quarter needs no code."
      },
      {
        "type": "text",
        "id": "season_number",
        "label": "Season number",
        "default": "01",
        "info": "Shown beside the wordmark and at the top of the home page."
      },
      {
        "type": "text",
        "id": "season_name",
        "label": "Season name",
        "default": "Ducks"
      },
      {
        "type": "text",
        "id": "season_period",
        "label": "Runs",
        "default": "Autumn — Winter 2026"
      },
      {
        "type": "select",
        "id": "season_motif",
        "label": "Motif",
        "info": "The line drawing used as the season's ornament, and as the fallback image on tiles with no photograph.",
        "options": [
          { "value": "duck", "label": "Duck" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "mushroom", "label": "Mushroom" },
          { "value": "flower", "label": "Flower" },
          { "value": "cherry", "label": "Cherry" },
          { "value": "bee", "label": "Bee" },
          { "value": "shell", "label": "Shell" },
          { "value": "star", "label": "Star" },
          { "value": "moon", "label": "Moon" },
          { "value": "snowflake", "label": "Snowflake" }
        ],
        "default": "duck"
      },
      {
        "type": "color",
        "id": "season_accent",
        "label": "Season accent",
        "default": "#B8863C",
        "info": "The only chromatic colour on the site. Everything else — the darker text version, the pale band and the colour of text placed on top of it — is worked out from this one value."
      },
      {
        "type": "header",
        "content": "Season link"
      },
      {
        "type": "collection",
        "id": "season_collection",
        "label": "Season collection",
        "info": "Linked from the wordmark area, the announcement bar and the footer."
      },
      {
        "type": "text",
        "id": "season_link_label",
        "label": "Season link label",
        "default": "Shop the season"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Wordmark",
        "default": "Julia Mind",
        "info": "Set in the display serif. Text, not an image, so it stays sharp everywhere."
      },
      {
        "type": "checkbox",
        "id": "logo_show_season",
        "label": "Show the season number beside the wordmark",
        "default": true
      },
      {
        "type": "range",
        "id": "logo_size",
        "label": "Wordmark size",
        "min": 16,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 23
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "Three warm papers and one ink. The season accent lives in the Season panel."
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Paper",
        "default": "#FAF8F3"
      },
      {
        "type": "color",
        "id": "color_paper_2",
        "label": "Paper — tinted band",
        "default": "#F4F1EA"
      },
      {
        "type": "color",
        "id": "color_paper_3",
        "label": "Paper — deep band",
        "default": "#EDE9DF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#17171A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fraunces for headlines, Inter for everything functional."
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base text size",
        "min": 15,
        "max": 19,
        "step": 1,
        "unit": "px",
        "default": 17
      },
      {
        "type": "range",
        "id": "type_display_weight",
        "label": "Headline weight",
        "min": 300,
        "max": 700,
        "step": 100,
        "default": 500
      },
      {
        "type": "range",
        "id": "type_display_wonk",
        "label": "Headline character",
        "min": 0,
        "max": 1,
        "step": 1,
        "default": 0,
        "info": "0 keeps the serif conventional. 1 lets its more unusual letterforms through."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_email", "label": "Contact email" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open the cart in a drawer",
        "default": true
      },
      {
        "type": "richtext",
        "id": "cart_note",
        "label": "Cart note",
        "default": "<p>Shipping and any taxes are worked out at checkout. Free UK delivery over £35.</p>"
      }
    ]
  }
]
