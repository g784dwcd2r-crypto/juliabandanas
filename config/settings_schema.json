  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo text",
        "default": "julia mind",
        "info": "Text-only logo. Each letter is coloured automatically in pink, yellow, green and black."
      },
      {
        "type": "select",
        "id": "logo_style",
        "label": "Logo colour pattern",
        "options": [
          {
            "value": "cycle",
            "label": "Cycle (pink, yellow, green, black)"
          },
          {
            "value": "words",
            "label": "Colour by word"
          },
          {
            "value": "mono",
            "label": "All black"
          }
        ],
        "default": "cycle"
      },
      {
        "type": "range",
        "id": "logo_size",
        "label": "Logo size",
        "min": 16,
        "max": 44,
        "step": 1,
        "unit": "px",
        "default": 24
