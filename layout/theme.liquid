<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_paper | default: '#FAF8F3' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      Fraunces carries the voice and Inter carries everything functional.
      Both are variable; Fraunces is loaded with its optical-size, SOFT and
      WONK axes because the theme sets them from the Typography settings.
    {%- endcomment -%}
    {%- assign font_url = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@400..600&display=swap' -%}
    <link rel="stylesheet" href="{{ font_url }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_url }}"></noscript>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      One accent is chosen in Customise → Season. The darker text version, the
      pale band and the colour of text placed on top of it are all worked out
      from it here, so a new season never needs a second colour picked by hand.
    {%- endcomment -%}
    {%- liquid
      assign paper = settings.color_paper | default: '#FAF8F3'
      assign ink = settings.color_ink | default: '#17171A'
      assign accent = settings.season_accent | default: '#B8863C'
      assign accent_b = accent | color_brightness

      if accent_b > 150
        assign accent_ink = accent | color_darken: 32
        assign accent_on = ink
      elsif accent_b > 90
        assign accent_ink = accent | color_darken: 18
        assign accent_on = '#FFFFFF'
      else
        assign accent_ink = accent
        assign accent_on = '#FFFFFF'
      endif

      assign accent_soft = accent | color_mix: paper, 13
    -%}
    <style>
      :root {
        --paper:      {{ paper }};
        --paper-2:    {{ settings.color_paper_2 | default: '#F4F1EA' }};
        --paper-3:    {{ settings.color_paper_3 | default: '#EDE9DF' }};
        --ink:        {{ ink }};
        --ink-70:     {{ ink | color_modify: 'alpha', 0.70 }};
        --ink-55:     {{ ink | color_modify: 'alpha', 0.55 }};
        --ink-38:     {{ ink | color_modify: 'alpha', 0.38 }};
        --ink-14:     {{ ink | color_modify: 'alpha', 0.14 }};
        --ink-07:     {{ ink | color_modify: 'alpha', 0.07 }};
        --accent:      {{ accent }};
        --accent-ink:  {{ accent_ink }};
        --accent-soft: {{ accent_soft }};
        --accent-on:   {{ accent_on }};
        --fs-base:     {{ settings.type_base_size | default: 17 }}px;
        --display-weight: {{ settings.type_display_weight | default: 500 }};
        --display-settings: "opsz" 120, "SOFT" 0, "WONK" {{ settings.type_display_wonk | default: 0 }};
        --logo-size:   {{ settings.logo_size | default: 23 }}px;
      }
    </style>

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.JM = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          cart_url: '{{ routes.cart_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        },
        cartDrawer: {{ settings.cart_drawer | default: true | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          error: {{ 'general.errors.generic' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template--{{ template.name | handle }}">
    <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
