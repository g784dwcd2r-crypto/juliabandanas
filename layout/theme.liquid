<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.season_c1 | default: '#FFC72C' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      Fraunces carries the voice and Inter carries everything functional.
      Both are variable; Fraunces is loaded with its optical-size, SOFT and
      WONK axes because the theme sets them from the Typography settings.
    {%- endcomment -%}
    {%- assign font_url = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@400..600&display=swap' -%}
    <link rel="stylesheet" href="{{ font_url }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_url }}"></noscript>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      The season palette is four flat field colours. For each one the theme
      works out the only text colour that clears roughly 4.5:1 against it —
      ink on light fields, white on dark ones — so a field chosen in the
      editor can never end up unreadable.

      --mark is the one accent used as small text on the page background, so
      it is left exactly as picked rather than being derived from a field.
    {%- endcomment -%}
    {%- liquid
      assign paper = settings.color_paper | default: '#FFFCF2'
      assign ink = settings.color_ink | default: '#111111'

      assign c1 = settings.season_c1 | default: '#FFC72C'
      assign c2 = settings.season_c2 | default: '#FF4D8D'
      assign c3 = settings.season_c3 | default: '#1D5CE8'
      assign c4 = settings.season_c4 | default: '#0F7A4F'
      assign mark = settings.season_mark | default: '#D6006E'

      assign c1_b = c1 | color_brightness
      assign c2_b = c2 | color_brightness
      assign c3_b = c3 | color_brightness
      assign c4_b = c4 | color_brightness

      assign c1_on = ink
      assign c2_on = ink
      assign c3_on = ink
      assign c4_on = ink
      if c1_b < 140
        assign c1_on = '#FFFFFF'
      endif
      if c2_b < 140
        assign c2_on = '#FFFFFF'
      endif
      if c3_b < 140
        assign c3_on = '#FFFFFF'
      endif
      if c4_b < 140
        assign c4_on = '#FFFFFF'
      endif
    -%}
    <style>
      :root {
        --paper:      {{ paper }};
        --paper-2:    {{ settings.color_paper_2 | default: '#FFF6DF' }};
        --ink:        {{ ink }};
        --ink-70:     {{ ink | color_modify: 'alpha', 0.70 }};
        --ink-55:     {{ ink | color_modify: 'alpha', 0.55 }};
        --ink-38:     {{ ink | color_modify: 'alpha', 0.38 }};
        --ink-14:     {{ ink | color_modify: 'alpha', 0.14 }};
        --ink-07:     {{ ink | color_modify: 'alpha', 0.07 }};
        --c1: {{ c1 }}; --c1-on: {{ c1_on }};
        --c2: {{ c2 }}; --c2-on: {{ c2_on }};
        --c3: {{ c3 }}; --c3-on: {{ c3_on }};
        --c4: {{ c4 }}; --c4-on: {{ c4_on }};
        --mark: {{ mark }};
        --fs-base:     {{ settings.type_base_size | default: 17 }}px;
        --display-weight: {{ settings.type_display_weight | default: 600 }};
        --display-settings: "opsz" 120, "SOFT" 0, "WONK" {% if settings.type_display_wonk %}1{% else %}0{% endif %};
        --logo-size:   {{ settings.logo_size | default: 23 }}px;
        --card-mat:    {{ settings.card_mat | default: 3 }}%;
      }
    </style>

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.JM = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          cart_url: '{{ routes.cart_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        },
        cartDrawer: {{ settings.cart_drawer | default: true | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          error: {{ 'general.errors.generic' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template--{{ template.name | handle }}">
    <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
