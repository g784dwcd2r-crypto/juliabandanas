<section class="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__head">
        <span class="hero__watermark hide-sm" aria-hidden="true">{% render 'season-motif' %}</span>

        <div class="hero__season">
          {% render 'season-line' %}
        </div>

        <h1 class="hero__title">{{ section.settings.heading }}</h1>

        {%- if section.settings.subheading != blank -%}
          <p class="lead hero__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="hero__cta">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="link" href="{{ section.settings.cta2_link }}">
              {{ section.settings.cta2_label }} {% render 'icon', name: 'arrow' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero__media reveal is-in">
        <figure class="hero__figure">
          <div class="media media--tall zoom">
            {%- if section.settings.image -%}
              <img src="{{ section.settings.image | image_url: width: 1100 }}"
                   srcset="{{ section.settings.image | image_url: width: 550 }} 550w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
                   sizes="(min-width: 750px) 48vw, 92vw"
                   alt="{{ section.settings.image.alt | escape }}"
                   width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
                   fetchpriority="high">
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if section.settings.caption_left != blank or section.settings.caption_right != blank -%}
            <figcaption class="hero__caption">
              <span>{{ section.settings.caption_left }}</span>
              <span>{{ section.settings.caption_right }}</span>
            </figcaption>
          {%- endif -%}
        </figure>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="hero__facts">
        {%- for block in section.blocks -%}
          <div class="hero__fact" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label }}</dt>
            <dd>{{ block.settings.text }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "html", "id": "heading", "label": "Heading",
      "info": "Wrap a word in <em> to set it in the italic accent.",
      "default": "Everything is about <em>ducks</em> right now."
    },
    {
      "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "A quarterly obsession. For the next three months the whole shop — hats, shirts, socks, prints, small odd things — answers to one subject. This one has feathers."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the season" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label", "default": "Read the season note" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption_left", "label": "Caption, left", "default": "Season 01" },
    { "type": "text", "id": "caption_right", "label": "Caption, right", "default": "Ducks" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free over £35" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "fact", "settings": { "label": "Season", "text": "One subject, three months" } },
        { "type": "fact", "settings": { "label": "Delivery", "text": "Free UK over £35" } },
        { "type": "fact", "settings": { "label": "Returns", "text": "30 days, unworn" } },
        { "type": "fact", "settings": { "label": "Next season", "text": "Announced in the letter" } }
      ]
    }
  ]
}
{% endschema %}
