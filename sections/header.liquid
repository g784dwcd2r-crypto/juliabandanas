<header class="header band--{{ section.settings.band }}" data-header>
  <div class="header__inner">
    <button class="icon-btn burger header__burger" type="button"
            data-drawer-open="menu-drawer"
            aria-expanded="false"
            aria-controls="menu-drawer"
            aria-label="{{ 'general.accessibility.menu' | t }}">
      <span class="burger__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    {%- if section.settings.menu != blank -%}
      <nav class="header__nav" aria-label="{{ 'general.accessibility.primary_nav' | t }}">
        {%- for link in section.settings.menu.links -%}
          <a class="nav-link" href="{{ link.url }}"
             {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="header__brand">
      {% render 'logo' %}
    </div>

    <div class="header__actions">
      <a class="icon-btn hide-sm" href="{{ routes.search_url }}" aria-label="{{ 'general.search.title' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      <a class="icon-btn cart-btn" href="{{ routes.cart_url }}"
         data-count="{{ cart.item_count }}"
         {% if settings.cart_drawer %}data-drawer-open="cart-drawer" aria-controls="cart-drawer" aria-expanded="false"{% endif %}
         aria-label="{{ 'sections.cart.title' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="icon-btn__count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div class="drawer drawer--left" id="menu-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.accessibility.menu' | t }}">
  <div class="drawer__scrim"></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      {% render 'logo', tag: 'div', size: 21 %}
      <button class="icon-btn" type="button" data-drawer-close data-drawer-focus aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="drawer__body">
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" style="margin-bottom: 26px">
        <label class="visually-hidden" for="drawer-search">{{ 'general.search.title' | t }}</label>
        <input class="input" id="drawer-search" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}">
        <button class="icon-btn" type="submit" aria-label="{{ 'general.search.submit' | t }}">
          {% render 'icon', name: 'search' %}
        </button>
      </form>

      {%- if section.settings.menu != blank -%}
        <ul class="menu-list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a class="menu-list__link" href="{{ link.url }}">
                {{ link.title }}
                {% render 'icon', name: 'arrow' %}
              </a>
              {%- if link.links.size > 0 -%}
                <div class="menu-sub">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}">{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="drawer__foot">
      {% render 'season-line', link: true %}
      {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_email != blank -%}
        <div class="footer__social" style="margin-top: 18px">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_email != blank -%}
            <a href="mailto:{{ settings.social_email }}" aria-label="Email">{% render 'icon', name: 'mail' %}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ]
}
{% endschema %}
