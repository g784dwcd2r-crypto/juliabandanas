{%- comment -%}
  A quiet strip of tracked capitals. When there is more than one message it
  drifts slowly; with a single message, or under prefers-reduced-motion, it
  simply sits still and centred.
{%- endcomment -%}

{%- liquid
  assign items = section.blocks
  assign is_static = false
  if items.size < 2
    assign is_static = true
  endif
-%}

{%- if items.size > 0 -%}
  <div class="announce band--{{ section.settings.band }}{% if is_static %} announce--static{% endif %}"
       style="--announce-speed: {{ section.settings.speed }}s">
    <div class="announce__track" aria-hidden="true">
      {%- for pass in (1..2) -%}
        <div class="announce__group">
          {%- for block in items -%}
            <span class="announce__item" {{ block.shopify_attributes }}>
              {%- unless forloop.first and is_static -%}
                <span class="announce__sep"></span>
              {%- endunless -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} The strip is decorative; assistive tech gets it once, statically. {%- endcomment -%}
    <span class="visually-hidden">
      {%- for block in items -%}{{ block.settings.text }}. {% endfor -%}
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "yellow"
    },
    {
      "type": "range", "id": "speed", "label": "Drift duration",
      "min": 20, "max": 90, "step": 5, "unit": "s", "default": 45
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Season 01 — Ducks" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Season 01 — Ducks" } },
        { "type": "message", "settings": { "text": "Free UK delivery over £35" } },
        { "type": "message", "settings": { "text": "30 days to change your mind" } }
      ]
    }
  ]
}
{% endschema %}
