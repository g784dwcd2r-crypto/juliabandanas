{%- comment -%}
  The season note — a short editorial statement explaining what the quarter is
  about. It sits between the shopping sections as the one place on the home page
  that is writing rather than merchandising.
{%- endcomment -%}

<section class="section band--{{ section.settings.band }}" id="season-note">
  <div class="wrap wrap--mid">
    <div class="motif--rule reveal" style="margin-bottom: 40px">
      {% render 'season-motif' %}
    </div>

    <div class="center reveal" data-reveal-delay="80">
      {%- if section.settings.label != blank -%}
        <p class="label" style="margin-bottom: 24px">{{ section.settings.label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte measure" style="margin: 26px auto 0">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <p class="label" style="margin-top: 30px">{{ section.settings.signature }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <p style="margin-top: 34px">
          <a class="link link--accent" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label }} {% render 'icon', name: 'arrow' %}
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Season note",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "A note on this season" },
    {
      "type": "text", "id": "heading", "label": "Heading",
      "default": "Why ducks, and why for three months"
    },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>Julia Mind runs one subject at a time. For a quarter, everything in the shop answers to it — the hats, the shirts, the socks, the prints on the wall, the thing stuck to the dashboard. Then the season closes and something else takes over.</p><p>Ducks came first because ducks are unreasonably good at this. They work on a bucket hat and they work framed above a kitchen table, and they manage to be funny without asking for attention.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Julia" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read the journal" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "tint", "label": "Tinted paper" },
        { "value": "deep", "label": "Deep paper" },
        { "value": "season", "label": "Season tint" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "season"
    }
  ],
  "presets": [{ "name": "Season note" }]
}
{% endschema %}
