<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="iwt{% if section.settings.flip %} iwt--flip{% endif %}">
      <div class="iwt__media reveal">
        <div class="media media--{{ section.settings.ratio }}" style="border:var(--line);box-shadow:var(--shadow-lg)">
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 1100 }}"
                 srcset="{{ section.settings.image | image_url: width: 550 }} 550w, {{ section.settings.image | image_url: width: 1100 }} 1100w"
                 sizes="(min-width: 750px) 48vw, 90vw"
                 alt="{{ section.settings.image.alt | escape }}"
                 width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
                 loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="iwt__text reveal" data-reveal-delay="100">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="margin-bottom:14px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte" style="margin-top:16px">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--pink" href="{{ section.settings.cta_link }}" style="margin-top:26px">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .iwt { display: grid; gap: 28px; }
  @media (min-width: 750px) {
    .iwt { grid-template-columns: 1fr 1fr; align-items: center; gap: 56px; }
    .iwt--flip .iwt__media { order: 2; }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "ratio", "label": "Image shape",
      "options": [
        { "value": "tall", "label": "Portrait" },
        { "value": "wide", "label": "Landscape" }
      ],
      "default": "tall"
    },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made by hand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every bandana starts as a drawing" },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>No clip art, no templates. I sketch each design on an iPad, colour it in pastel pink, yellow and green, and print it onto soft cotton that survives the park.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "green"
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
