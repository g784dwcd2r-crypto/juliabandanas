<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" data-reveal-delay="{{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <span class="step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="step__title">{{ block.settings.heading }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:32px">
        <a class="btn btn--green" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The good bits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small shop, high standards" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop everything" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "yellow"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Drawn by hand" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every drawing starts from scratch." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Drawn by hand", "text": "Every duck, frog and mushroom starts as a drawing. No stock art, no templates, nothing generated." } },
        { "type": "step", "settings": { "heading": "Printed properly", "text": "Thick matte vinyl for stickers, heavy uncoated card for prints, soft cotton for anything you wear." } },
        { "type": "step", "settings": { "heading": "Posted quickly", "text": "Packed in a recycled mailer and posted within two working days. Free UK shipping over £35." } }
      ]
    }
  ]
}
{% endschema %}
