<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" data-reveal-delay="{{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <span class="step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="step__title">{{ block.settings.heading }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:32px">
        <a class="btn btn--green" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The good bits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small shop, high standards" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop everything" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "yellow"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Picked one by one" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Everything here is chosen by hand." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Picked one by one", "text": "Everything here is chosen by hand. If it isn't something I'd wear or put on my own wall, it doesn't go in the shop." } },
        { "type": "step", "settings": { "heading": "Checked before it ships", "text": "Sizes, materials and photos are checked against the real thing, so what turns up is what you thought you were buying." } },
        { "type": "step", "settings": { "heading": "Posted quickly", "text": "Packed and sent as fast as I can manage. Free UK shipping over £35, and 30 days to change your mind." } }
      ]
    }
  ]
}
{% endschema %}
