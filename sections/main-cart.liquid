<div class="wrap">
  <header class="page-head">
    <p class="label page-head__label">{{ shop.name }}</p>
    <h1>{{ 'sections.cart.title' | t }}</h1>
  </header>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <span class="empty-state__mark motif">{% render 'season-motif' %}</span>
      <h2 class="h3">{{ 'sections.cart.empty' | t }}</h2>
      <p class="muted" style="margin-top: 10px">{{ 'sections.cart.empty_note' | t }}</p>
      <p style="margin-top: 26px">
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'sections.cart.continue_shopping' | t }}</a>
      </p>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart__grid">
        <div>
          {%- for line in cart.items -%}
            <div class="cart-line" data-line-key="{{ line.key }}" data-line-qty="{{ line.quantity }}">
              <a class="cart-line__media" href="{{ line.url }}" tabindex="-1" aria-hidden="true">
                {%- if line.image -%}
                  <img src="{{ line.image | image_url: width: 220 }}" alt="" width="110" height="138" loading="lazy">
                {%- endif -%}
              </a>
              <div>
                <a class="cart-line__title" href="{{ line.url }}">{{ line.product.title | escape }}</a>
                {%- unless line.variant.title contains 'Default' -%}
                  <p class="cart-line__variant">{{ line.variant.title }}</p>
                {%- endunless -%}

                {% render 'line-item-properties', properties: line.properties %}

                <div class="cart-line__foot">
                  <span class="qty">
                    <button class="qty__btn" type="button" data-cart-qty="down" aria-label="{{ 'sections.cart.decrease' | t }}">
                      {% render 'icon', name: 'minus' %}
                    </button>
                    <label class="visually-hidden" for="qty-{{ line.index }}">{{ 'products.product.quantity' | t }}</label>
                    <input class="qty__input" id="qty-{{ line.index }}" type="number"
                           value="{{ line.quantity }}" min="0" inputmode="numeric" data-cart-qty-input>
                    <button class="qty__btn" type="button" data-cart-qty="up" aria-label="{{ 'sections.cart.increase' | t }}">
                      {% render 'icon', name: 'plus' %}
                    </button>
                  </span>
                  <span class="cart-line__price">{{ line.final_line_price | money }}</span>
                </div>
                <button class="cart-line__remove" type="button" data-cart-remove="{{ line.key }}" style="margin-top: 14px">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </div>
          {%- endfor -%}

          <div style="margin-top: 34px">
            <label class="field__label" for="cart-note">{{ 'sections.cart.note' | t }}</label>
            <textarea class="textarea textarea--boxed" id="cart-note" name="note" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
          </div>
        </div>

        <aside class="cart__aside">
          <div class="cart-summary">
            <div class="cart-summary__row">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row" style="margin-top: 10px">
                  <span>{{ discount.title }}</span>
                  <span>&minus;{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
            <div class="cart-summary__row cart-summary__row--total">
              <span>{{ 'sections.cart.total' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="small muted" style="margin-top: 12px">{{ 'sections.cart.tax_note' | t }}</p>

            <button class="btn btn--full" type="submit" name="checkout" style="margin-top: 22px">
              {{ 'sections.cart.checkout' | t }}
            </button>
            <button class="btn btn--outline btn--full btn--sm" type="submit" name="update" style="margin-top: 10px">
              {{ 'sections.cart.update' | t }}
            </button>
          </div>

          {%- if settings.cart_note != blank -%}
            <div class="rte small" style="margin-top: 20px">{{ settings.cart_note }}</div>
          {%- endif -%}
        </aside>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
