<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="muted" style="max-width: 46ch">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link sec-head__link" href="{{ section.settings.link_url }}">
          {{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="cats" {% render 'grid-columns', cols: section.settings.cols, cols_sm: section.settings.cols_sm %}>
      {%- for block in section.blocks -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 4 | times: 70 }}" {{ block.shopify_attributes }}>
          {% render 'collection-tile',
              tile_collection: block.settings.collection,
              label: block.settings.label,
              show_count: section.settings.show_counts,
              mat: section.settings.tile_mat,
              ratio: section.settings.tile_ratio %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection index",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where to start" },
    {
      "type": "textarea", "id": "text", "label": "Text",
      "default": "The same subject, worked through everything you might reasonably want it on."
    },
    { "type": "checkbox", "id": "show_counts", "label": "Show how many products are in each", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "cols", "label": "Collections per row, desktop",
      "min": 2, "max": 6, "step": 1, "default": 4
    },
    {
      "type": "range", "id": "cols_sm", "label": "Collections per row, phone",
      "min": 1, "max": 3, "step": 1, "default": 2
    },
    { "type": "header", "content": "The images" },
    {
      "type": "select", "id": "tile_ratio", "label": "Image shape",
      "info": "Match the image keeps each collection photo in its own proportions and crops nothing, so tiles in a row can be different heights. The names still line up.",
      "options": [
        { "value": "wide", "label": "Landscape" },
        { "value": "square", "label": "Square" },
        { "value": "tall", "label": "Portrait" },
        { "value": "natural", "label": "Match the image" }
      ],
      "default": "wide"
    },
    {
      "type": "range", "id": "tile_mat", "label": "Colour border",
      "info": "The band of season colour around each photo. Set it to 0 to remove it and let the photo fill the tile.",
      "min": 0, "max": 12, "step": 1, "unit": "%", "default": 3
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Everything" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to use the collection name." }
      ]
    }
  ],
  "presets": [{ "name": "Collection index" }]
}
{% endschema %}
