<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        {% render 'logo', tag: 'div', size: 30 %}
        {%- if section.settings.blurb != blank -%}
          <p class="muted" style="margin-top:14px;max-width:38ch">{{ section.settings.blurb }}</p>
        {%- endif -%}

        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_email != blank -%}
            <a href="mailto:{{ settings.social_email }}" aria-label="Email">{% render 'icon', name: 'mail' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__col-title">{{ block.settings.heading }}</h2>
              {%- if block.settings.menu != blank -%}
                <nav class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {%- endfor -%}
                </nav>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__col-title">{{ block.settings.heading }}</h2>
              <p class="small muted">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'nl-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="nl">
                  <label class="visually-hidden" for="footer-email">{{ 'general.newsletter.email' | t }}</label>
                  <input class="input" id="footer-email" type="email" name="contact[email]"
                         placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
                  <button class="btn btn--sm btn--green" type="submit" aria-label="{{ 'general.newsletter.submit' | t }}">
                    {% render 'icon', name: 'arrow' %}
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--ok">{{ 'general.newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="form-status form-status--err">{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span class="muted">{{ section.settings.credit }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea", "id": "blurb", "label": "About text",
      "default": "Hand-drawn stickers, prints and bits and bobs, made in small batches. Ducks, mushrooms, frogs and whatever else turns up."
    },
    { "type": "text", "id": "credit", "label": "Bottom-right text", "default": "Drawn by hand in the UK" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get the good post" },
        { "type": "text", "id": "text", "label": "Text", "default": "New drawings, restocks and the occasional very smug frog." }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
