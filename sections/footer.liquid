<footer class="footer band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="footer__top">
      <div>
        {% render 'logo', tag: 'div', size: 27 %}
        {%- if section.settings.blurb != blank -%}
          <p class="footer__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}

        {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_email != blank -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
            {%- endif -%}
            {%- if settings.social_email != blank -%}
              <a href="mailto:{{ settings.social_email }}" aria-label="Email">{% render 'icon', name: 'mail' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__col-title">{{ block.settings.heading }}</h2>
              {%- if block.settings.menu != blank -%}
                <nav class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {%- endfor -%}
                </nav>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__col-title">{{ block.settings.heading }}</h2>
              <p class="small muted">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'nl-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="nl">
                  <label class="visually-hidden" for="footer-email">{{ 'general.newsletter.email' | t }}</label>
                  <input class="input" id="footer-email" type="email" name="contact[email]"
                         placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
                  <button class="btn btn--sm" type="submit">{{ 'general.newsletter.submit' | t }}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--ok">{{ 'general.newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="form-status form-status--err">{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      {% render 'season-line', link: true %}
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.credit }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    {
      "type": "textarea", "id": "blurb", "label": "About text",
      "default": "One subject at a time, for three months at a time. Hats, shirts, socks, prints and small odd things, all answering to the season."
    },
    { "type": "text", "id": "credit", "label": "Bottom-right text", "default": "Shipped from the UK." }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The season letter" },
        { "type": "text", "id": "text", "label": "Text", "default": "One email when a season opens, one when it closes, and nothing in between." }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
