<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="quotes no-scrollbar">
      {%- for block in section.blocks -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <figure class="quote">
            <span class="quote__stars" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.stars }}">
              {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
            </span>
            <blockquote class="quote__text" style="border:0;background:none;padding:0;margin:0;border-radius:0">
              {{ block.settings.text }}
            </blockquote>
            <figcaption class="quote__who">{{ block.settings.author }}</figcaption>
          </figure>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the humans say" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Quote", "default": "It looks exactly like her." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sam & Mochi" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote", "settings": { "text": "I sent one photo and a sentence about her being dramatic. What came back was so her that I cried a bit.", "author": "Sam & Mochi" } },
        { "type": "quote", "settings": { "text": "The colours are soft but they really pop in photos. He has three now. I have a problem.", "author": "Priya & Biscuit" } },
        { "type": "quote", "settings": { "text": "Ordered on a Sunday, wearing it by Friday, and the fabric has survived four washes and one lake.", "author": "Tom & Nala" } }
      ]
    }
  ]
}
{% endschema %}
