<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="quotes no-scrollbar">
      {%- for block in section.blocks -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <figure class="quote">
            {%- if block.settings.stars > 0 -%}
              <span class="quote__stars" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.stars }}">
                {%- for i in (1..block.settings.stars) -%}&#9679;{%- endfor -%}
              </span>
            {%- endif -%}
            <blockquote class="quote__text">{{ block.settings.text }}</blockquote>
            <figcaption class="quote__who">{{ block.settings.author }}</figcaption>
          </figure>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quotes",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "From the post" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people said about it" },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "range", "id": "stars", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Quote", "default": "Better in person than in the photographs." },
        { "type": "text", "id": "author", "label": "Author", "default": "Rosie, Leeds" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quotes",
      "blocks": [
        { "type": "quote", "settings": { "text": "I bought the bucket hat as a joke and have now worn it every day for a month. The joke is on me.", "author": "Rosie, Leeds" } },
        { "type": "quote", "settings": { "text": "The print is genuinely lovely — properly framed it does not read as novelty at all, which I did not expect.", "author": "Alex, Bristol" } },
        { "type": "quote", "settings": { "text": "Ordered on the Sunday, wearing the socks by the Thursday. No notes.", "author": "Mina, Glasgow" } }
      ]
    }
  ]
}
{% endschema %}
