<div class="wrap wrap--narrow">
  <div class="bare">
    <span class="bare__mark motif">{% render 'season-motif' %}</span>
    <p class="label">{{ 'general.404.label' | t }}</p>
    <h1>{{ 'general.404.title' | t }}</h1>
    <p class="lead" style="margin-inline: auto">{{ 'general.404.text' | t }}</p>
    <a class="btn" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
