{%- comment -%}
  Three short notes on how the shop operates. Numbered, ruled, no boxes.
{%- endcomment -%}

<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="link sec-head__link" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="notes">
      {%- for block in section.blocks -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <div class="note">
            <span class="note__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="note__title">{{ block.settings.heading }}</h3>
            <p class="note__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop notes",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The arrangement" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three things worth knowing" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "tint", "label": "Tinted paper" },
        { "value": "deep", "label": "Deep paper" },
        { "value": "season", "label": "Season tint" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen, not collected" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Everything is picked by hand." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop notes",
      "blocks": [
        { "type": "note", "settings": { "heading": "Chosen, not collected", "text": "Everything in a season is picked by hand and photographed as it actually arrives. Nothing goes in because it fills a gap." } },
        { "type": "note", "settings": { "heading": "It ends", "text": "A season runs for three months. When it closes, what has sold out stays sold out — the next quarter is a different subject entirely." } },
        { "type": "note", "settings": { "heading": "Sent quickly, returned easily", "text": "Free UK delivery over £35 and worldwide shipping at checkout. Thirty days to send something back, unworn." } }
      ]
    }
  ]
}
{% endschema %}
