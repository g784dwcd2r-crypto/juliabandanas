<section class="section section--tight band--{{ section.settings.band }}">
  <div class="wrap wrap--mid center reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="margin-bottom:16px">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lead muted" style="margin:16px auto 0;max-width:46ch">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--ink" href="{{ section.settings.cta_link }}" style="margin-top:28px">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Go on then" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bag needs a frog on it" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ten categories, all drawn by hand, all posted within two working days." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Design yours" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "pink"
    }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
