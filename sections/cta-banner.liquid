<section class="section section--tight band--{{ section.settings.band }}">
  <div class="wrap wrap--mid center reveal">
    {%- if section.settings.label != blank -%}
      <p class="label" style="margin-bottom: 22px">{{ section.settings.label }}</p>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lead" style="margin: 20px auto 0">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <p style="margin-top: 34px">
        <a class="btn {% if section.settings.band == 'ink' %}btn--light{% endif %}" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Before it closes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Season 01 runs until the end of the quarter" },
    {
      "type": "textarea", "id": "text", "label": "Text",
      "default": "When it ends, what has gone has gone. The next subject has already been chosen and it is not this one."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the season" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
