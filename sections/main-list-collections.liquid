<div class="wrap">
  <header class="page-head page-head--split">
    <div>
      <p class="label page-head__label">{{ 'sections.collections.label' | t }}</p>
      <h1>{{ 'sections.collections.title' | t }}</h1>
    </div>
    <p class="lead page-head__intro">{{ 'sections.collections.intro' | t }}</p>
  </header>

  <div class="cats" {% render 'grid-columns', cols: settings.grid_cols, cols_sm: settings.grid_cols_sm %}>
    {%- for coll in collections -%}
      <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 4 | times: 60 }}">
        {% render 'collection-tile', tile_collection: coll, show_count: true %}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
