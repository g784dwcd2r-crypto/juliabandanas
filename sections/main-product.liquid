{%- assign v = product.selected_or_first_available_variant -%}

<div class="wrap">
  <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>
</div>

<section class="product">
  <div class="wrap">
    <div class="product__grid">

      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div class="product__gallery" data-gallery>
        {%- if product.media.size > 1 -%}
          <span class="gallery__count hide-lg">
            <span data-gallery-current>1</span>/{{ product.media.size }}
          </span>
        {%- endif -%}

        <div class="gallery__rail no-scrollbar">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="gallery__slide">
                <img
                  src="{{ media | image_url: width: 1100 }}"
                  srcset="{{ media | image_url: width: 550 }} 550w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 560px, 92vw"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="{{ media.width }}" height="{{ media.height }}"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="gallery__slide">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="gallery__dots hide-lg">
            {%- for media in product.media -%}
              <button class="gallery__dot{% if forloop.first %} is-active{% endif %}" type="button"
                      aria-label="{{ 'products.product.go_to_image' | t: index: forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Buy column ---------- {%- endcomment -%}
      <div class="product__head">
        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <p class="eyebrow muted">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="h1 product__title" style="font-size:clamp(2rem,8.5vw,3.2rem)">{{ product.title | escape }}</h1>

        <div class="product__price" data-product-price>
          {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
          {{ v.price | money }}
        </div>
        <p class="product__price-note">{{ 'products.product.price_note' | t }}</p>

        {%- if product.description != blank -%}
          <div class="rte product__desc">{{ product.description }}</div>
        {%- endif -%}

        <form method="post" action="{{ routes.cart_add_url }}" id="product-form" accept-charset="UTF-8"
              data-product-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>

          {%- comment -%} ---------- Variants ---------- {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="variants" data-variant-picker>
              {%- for option in product.options_with_values -%}
                <fieldset style="border:0;padding:0;margin:0">
                  <legend class="variant__legend">
                    <span>{{ option.name }}</span>
                    <span class="variant__value">{{ option.selected_value }}</span>
                  </legend>
                  <div class="variant__opts">
                    {%- for value in option.values -%}
                      {%- assign input_id = 'opt-' | append: option.position | append: '-' | append: forloop.index -%}
                      <label class="variant__opt" for="{{ input_id }}">
                        <input type="radio" id="{{ input_id }}"
                               name="option-{{ option.position }}"
                               value="{{ value | escape }}"
                               {% if option.selected_value == value %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}

              <script type="application/json" data-variant-json>
                [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id }},
                      "price": {{ variant.price }},
                      "available": {{ variant.available }},
                      "options": {{ variant.options | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            </div>
          {%- endunless -%}

          {%- comment -%} ---------- Buy ---------- {%- endcomment -%}
          <div class="product__buy" data-buybar-anchor>
            <div class="qty">
              <button class="qty__btn" type="button" data-qty="down" aria-label="{{ 'sections.cart.decrease' | t }}">&minus;</button>
              <label class="visually-hidden" for="product-qty">{{ 'products.product.quantity' | t }}</label>
              <input class="qty__input" id="product-qty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button class="qty__btn" type="button" data-qty="up" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
            </div>
            <button class="btn btn--ink" type="submit" name="add" data-add-to-cart
                    {% unless v.available %}aria-disabled="true"{% endunless %}>
              {%- if v.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
          </div>
          <p class="form-status form-status--err" data-form-error hidden></p>
        </form>

        {%- comment -%} ---------- Reassurance ---------- {%- endcomment -%}
        <div class="product__reassure">
          {%- for block in section.blocks -%}
            {%- if block.type == 'reassurance' -%}
              <p class="reassure" {{ block.shopify_attributes }}>
                {% render 'icon', name: block.settings.icon %}
                <span>{{ block.settings.text }}</span>
              </p>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} ---------- Accordions ---------- {%- endcomment -%}
        {%- assign has_acc = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}{%- assign has_acc = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_acc -%}
          <div class="acc">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details class="acc__item" {{ block.shopify_attributes }}>
                  <summary class="acc__summary">
                    {{ block.settings.heading }}
                    <span class="acc__icon">{% render 'icon', name: 'plus' %}</span>
                  </summary>
                  <div class="acc__body rte">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky mobile buy bar {%- endcomment -%}
<div class="buybar" data-buybar>
  <div class="buybar__info">
    <div class="buybar__name">{{ product.title | escape }}</div>
    <div class="buybar__price" data-buybar-price>{{ v.price | money }}</div>
  </div>
  <button class="btn btn--ink" type="button" data-buybar-submit>
    {{ 'products.product.add_to_cart' | t }}
  </button>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},{% endif %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "price": {{ v.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Reassurance line",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "brush", "label": "Brush" },
            { "value": "truck", "label": "Delivery" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "paw", "label": "Paw" }
          ],
          "default": "brush"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Hand-drawn, never a template" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sizing" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Tell us about sizes here.</p>" }
      ]
    }
  ]
}
{% endschema %}
