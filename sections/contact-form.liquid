<section class="section band--{{ section.settings.band }}">
  <div class="wrap wrap--narrow">
    <div style="margin-bottom: 40px">
      {%- if section.settings.label != blank -%}
        <p class="label" style="margin-bottom: 18px">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead" style="margin-top: 18px">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--ok" style="margin-bottom: 24px">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--err" style="margin-bottom: 24px">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="form-grid form-grid--2">
        <div class="field">
          <label class="field__label" for="contact-name">{{ 'contact.name' | t }}</label>
          <input class="input" id="contact-name" type="text" name="contact[name]" autocomplete="name" required>
        </div>
        <div class="field">
          <label class="field__label" for="contact-email">{{ 'contact.email' | t }}</label>
          <input class="input" id="contact-email" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="field form-grid__full">
          <label class="field__label" for="contact-order">
            {{ 'contact.order' | t }}
            <span class="field__hint">{{ 'contact.optional' | t }}</span>
          </label>
          <input class="input" id="contact-order" type="text" name="contact[Order number]"
                 autocapitalize="characters" spellcheck="false">
        </div>
        <div class="field form-grid__full">
          <label class="field__label" for="contact-body">{{ 'contact.message' | t }}</label>
          <textarea class="textarea" id="contact-body" name="contact[body]" required></textarea>
        </div>
      </div>
      <button class="btn btn--full" type="submit" style="margin-top: 30px">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, orders, and what the next season should be" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A parcel that has gone astray, a size you are unsure about, or a subject you think a future season should be built around. It all reaches the same inbox." },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
