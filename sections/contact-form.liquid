<section class="section band--{{ section.settings.band }}">
  <div class="wrap wrap--narrow">
    <div class="center" style="margin-bottom:32px">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="muted" style="margin:14px auto 0;max-width:44ch">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--ok" style="margin-bottom:20px">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--err" style="margin-bottom:20px">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="form-grid form-grid--2">
        <div class="field">
          <label class="field__label" for="contact-name">{{ 'contact.name' | t }}</label>
          <input class="input" id="contact-name" type="text" name="contact[name]" autocomplete="name" required>
        </div>
        <div class="field">
          <label class="field__label" for="contact-email">{{ 'contact.email' | t }}</label>
          <input class="input" id="contact-email" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="field form-grid__full">
          <label class="field__label" for="contact-ig">{{ 'contact.pet_ig' | t }}</label>
          <input class="input" id="contact-ig" type="text" name="contact[Pet Instagram]"
                 placeholder="@yourpet" autocapitalize="none" spellcheck="false" data-ig-field>
        </div>
        <div class="field form-grid__full">
          <label class="field__label" for="contact-body">{{ 'contact.message' | t }}</label>
          <textarea class="textarea" id="contact-body" name="contact[body]" required></textarea>
        </div>
      </div>
      <button class="btn btn--ink btn--full" type="submit" style="margin-top:22px">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hi" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Got a question or a big idea?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Custom orders, bulk orders, or a photo you're desperate to send me — this reaches my inbox." },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
