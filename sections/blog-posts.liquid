{%- assign blog = blogs[section.settings.blog] -%}
<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a class="btn btn--sm btn--ghost sec-head__link" href="{{ blog.url }}">
          {{ 'blogs.article.read_all' | t }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="blog-grid">
      {%- for article in blog.articles limit: section.settings.count -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 80 }}">
          {% render 'article-card', article: article %}
        </div>
      {%- else -%}
        <p class="muted">{{ 'blogs.article.none' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bits of reading" },
    { "type": "range", "id": "count", "label": "Posts shown", "min": 2, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
