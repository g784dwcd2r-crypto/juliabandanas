{%- assign blog = blogs[section.settings.blog] -%}
<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a class="link sec-head__link" href="{{ blog.url }}">
          {{ 'blogs.article.read_all' | t }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="blog-grid" {% render 'grid-columns', cols: section.settings.cols, cols_sm: section.settings.cols_sm %}>
      {%- for article in blog.articles limit: section.settings.count -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 80 }}">
          {% render 'article-card', article: article %}
        </div>
      {%- else -%}
        <p class="muted">{{ 'blogs.article.none' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal posts",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reading, while you decide"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Posts shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cols",
      "label": "Posts per row, desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "cols_sm",
      "label": "Posts per row, phone",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Page background"
        },
        {
          "value": "tint",
          "label": "Quiet band"
        },
        {
          "value": "yellow",
          "label": "Colour 1"
        },
        {
          "value": "pink",
          "label": "Colour 2"
        },
        {
          "value": "blue",
          "label": "Colour 3"
        },
        {
          "value": "green",
          "label": "Colour 4"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "tint"
    }
  ],
  "presets": [
    {
      "name": "Journal posts"
    }
  ]
}
{% endschema %}
