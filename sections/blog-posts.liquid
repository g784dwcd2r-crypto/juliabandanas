{%- assign blog = blogs[section.settings.blog] -%}
<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a class="link sec-head__link" href="{{ blog.url }}">
          {{ 'blogs.article.read_all' | t }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="blog-grid">
      {%- for article in blog.articles limit: section.settings.count -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | times: 80 }}">
          {% render 'article-card', article: article %}
        </div>
      {%- else -%}
        <p class="muted">{{ 'blogs.article.none' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "label", "label": "Label", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reading, while you decide" },
    { "type": "range", "id": "count", "label": "Posts shown", "min": 2, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "tint", "label": "Tinted paper" },
        { "value": "deep", "label": "Deep paper" },
        { "value": "season", "label": "Season tint" }
      ],
      "default": "tint"
    }
  ],
  "presets": [{ "name": "Journal posts" }]
}
{% endschema %}
