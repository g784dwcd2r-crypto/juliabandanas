<div class="wrap">
  <header class="page-head page-head--split">
    <div>
      <p class="label page-head__label">{{ 'sections.collection.label' | t }}</p>
      <h1>{{ collection.title }}</h1>
    </div>
    {%- if collection.description != blank -%}
      <div class="rte page-head__intro">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by 24 -%}
    <div class="coll-bar">
      <span class="coll-bar__count">
        {{ 'sections.collection.count' | t: count: collection.products_count }}
      </span>
      <div>
        <label class="visually-hidden" for="sort-by">{{ 'sections.collection.sort' | t }}</label>
        <select class="select" id="sort-by" data-sort>
          {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="pgrid" {% render 'grid-columns', cols: settings.grid_cols, cols_sm: settings.grid_cols_sm %}>
        {%- for product in collection.products -%}
          <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 4 | times: 60 }}">
            {% render 'product-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state">
        <span class="empty-state__mark motif">{% render 'season-motif' %}</span>
        <h2 class="h3">{{ 'sections.collection.empty' | t }}</h2>
        <p style="margin-top: 22px">
          <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">
            {{ 'sections.cart.continue_shopping' | t }}
          </a>
        </p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
