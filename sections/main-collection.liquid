<div class="wrap">
  <header class="coll-head">
    <p class="eyebrow" style="margin-bottom:12px">{{ 'sections.collection.eyebrow' | t }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte muted" style="margin-top:14px;max-width:56ch">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by 16 -%}
    <div class="coll-bar">
      <span class="coll-bar__count">
        {{ 'sections.collection.count' | t: count: collection.products_count }}
      </span>
      <label class="visually-hidden" for="sort-by">{{ 'sections.collection.sort' | t }}</label>
      <select class="select" id="sort-by" data-sort>
        {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="pgrid pgrid--4">
        {%- for product in collection.products -%}
          <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 4 | times: 60 }}">
            {% render 'product-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state">
        <div class="empty-state__emoji">🐶</div>
        <h2 class="h3">{{ 'sections.collection.empty' | t }}</h2>
        <a class="btn btn--pink" href="{{ routes.all_products_collection_url }}" style="margin-top:20px">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
