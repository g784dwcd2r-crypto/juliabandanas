<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="center reveal" style="margin-bottom:34px">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="faq reveal">
      <div class="acc">
        {%- for block in section.blocks -%}
          <details class="acc__item" {{ block.shopify_attributes }}>
            <summary class="acc__summary">
              {{ block.settings.question }}
              <span class="acc__icon">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="acc__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you might ask" },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How quickly do you post?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Within two working days, first class.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What are the stickers actually made of?", "answer": "<p>Thick matte vinyl. Waterproof, dishwasher-safe on a bottle, and they peel off cleanly if you change your mind.</p>" } },
        { "type": "qa", "settings": { "question": "How quickly do you post?", "answer": "<p>Within two working days, first class. Free UK shipping over £35, and yes, I post worldwide.</p>" } },
        { "type": "qa", "settings": { "question": "Can I request a creature?", "answer": "<p>Please do. Several categories exist because somebody messaged me asking for a snail.</p>" } },
        { "type": "qa", "settings": { "question": "Is any of this AI?", "answer": "<p>No. Every drawing is made by hand on an iPad, by me.</p>" } }
      ]
    }
  ]
}
{% endschema %}
