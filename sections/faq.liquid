<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="faq reveal">
      <div class="acc">
        {%- for block in section.blocks -%}
          <details class="acc__item" {{ block.shopify_attributes }}>
            <summary class="acc__summary">
              {{ block.settings.question }}
              <span class="acc__icon">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="acc__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The practical part" },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How quickly do orders go out?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Within two working days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What actually is a season?", "answer": "<p>A single subject that the whole shop is built around for three months. Season 01 is ducks. When it closes, the range is replaced rather than added to.</p>" } },
        { "type": "qa", "settings": { "question": "What happens to things that sell out?", "answer": "<p>They stay sold out. Stock is bought once per season, so if something goes early it does not come back.</p>" } },
        { "type": "qa", "settings": { "question": "How do the hats fit?", "answer": "<p>Most bucket hats are a 56–58cm one size. Where a product has several sizes they are listed on its own page — measure around your head just above the ears and go by that.</p>" } },
        { "type": "qa", "settings": { "question": "Delivery and returns?", "answer": "<p>Free UK delivery over £35, worldwide shipping calculated at checkout, and thirty days to send something back unworn and in its packaging.</p>" } },
        { "type": "qa", "settings": { "question": "Can I suggest the next season?", "answer": "<p>Yes, and it works — subjects get chosen partly from what people ask for. Reply to the season letter or send an email.</p>" } }
      ]
    }
  ]
}
{% endschema %}
