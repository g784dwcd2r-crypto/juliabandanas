{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.count

  # On phones the row is either a swipe rail or a plain grid; on desktop both
  # become the same grid, so only the mobile behaviour actually differs.
  assign grid_class = 'prail'
  if section.settings.mobile_layout == 'grid'
    assign grid_class = 'pgrid'
  endif
-%}

<section class="section band--{{ section.settings.band }}">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-head__text">
        {%- if section.settings.label != blank -%}
          <p class="label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="muted" style="max-width: 46ch">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if coll != blank -%}
        <a class="link sec-head__link" href="{{ coll.url }}">
          {{ 'sections.collection.view_all' | t }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if coll.products.size > 0 -%}
      <div class="{{ grid_class }} no-scrollbar" {% render 'grid-columns', cols: section.settings.cols, cols_sm: section.settings.cols_sm %}>
        {%- for product in coll.products limit: limit -%}
          <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 4 | times: 70 }}">
            {% render 'product-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.mobile_layout != 'grid' -%}
        <div class="rail-hint" aria-hidden="true">
          {%- for i in (1..3) -%}<span></span>{%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="{{ grid_class }} no-scrollbar" {% render 'grid-columns', cols: section.settings.cols, cols_sm: section.settings.cols_sm %}>
        {%- for i in (1..3) -%}
          <div class="pcard">
            <div class="pcard__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="pcard__body">
              <h3 class="pcard__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="pcard__price">{{ 1499 | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "In the season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The pieces doing the most work"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cols",
      "label": "Products per row, desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "cols_sm",
      "label": "Products per row, phone",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "On phones",
      "info": "A swipe rail keeps the row to one line and lets people flick through it. A grid stacks them instead.",
      "options": [
        {
          "value": "rail",
          "label": "Swipe sideways"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "rail"
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Page background"
        },
        {
          "value": "tint",
          "label": "Quiet band"
        },
        {
          "value": "yellow",
          "label": "Colour 1"
        },
        {
          "value": "pink",
          "label": "Colour 2"
        },
        {
          "value": "blue",
          "label": "Colour 3"
        },
        {
          "value": "green",
          "label": "Colour 4"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
