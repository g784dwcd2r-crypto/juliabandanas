<div class="wrap">
  <header class="coll-head center">
    <p class="eyebrow" style="margin-bottom:12px">{{ 'blogs.article.eyebrow' | t }}</p>
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="lead muted" style="margin:16px auto 0;max-width:52ch">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  {%- if blog.all_tags.size > 0 -%}
    <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:16px;margin-bottom:26px" class="no-scrollbar">
      <a class="pill{% unless current_tags %} pill--pink{% endunless %}" href="{{ blog.url }}">{{ 'blogs.article.all' | t }}</a>
      {%- for tag in blog.all_tags -%}
        <a class="pill{% if current_tags contains tag %} pill--pink{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- paginate blog.articles by 12 -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <div class="reveal" data-reveal-delay="{{ forloop.index0 | modulo: 3 | times: 80 }}">
          {% render 'article-card', article: article %}
        </div>
      {%- else -%}
        <p class="muted">{{ 'blogs.article.none' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "textarea", "id": "intro", "label": "Intro",
      "default": "Notes from the drawing board — how things get made, what they're printed on, and where the sillier ideas come from."
    }
  ]
}
{% endschema %}
