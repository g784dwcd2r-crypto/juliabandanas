<section class="section band--{{ section.settings.band }}">
  <div class="wrap wrap--narrow reveal {% if section.settings.center %}center{% endif %}">
    {%- if section.settings.label != blank -%}
      <p class="label" style="margin-bottom: 20px">{{ section.settings.label }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte" style="margin-top: 24px">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write something here.</p>" },
    { "type": "checkbox", "id": "center", "label": "Centre the text", "default": false },
    {
      "type": "select", "id": "band", "label": "Background",
            "options": [
        { "value": "paper", "label": "Page background" },
        { "value": "tint", "label": "Quiet band" },
        { "value": "yellow", "label": "Colour 1" },
        { "value": "pink", "label": "Colour 2" },
        { "value": "blue", "label": "Colour 3" },
        { "value": "green", "label": "Colour 4" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
