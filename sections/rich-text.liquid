<section class="section band--{{ section.settings.band }}">
  <div class="wrap wrap--narrow reveal {% if section.settings.center %}center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="margin-bottom:14px">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte" style="margin-top:18px">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hello" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "checkbox", "id": "center", "label": "Centre the text", "default": false },
    {
      "type": "select", "id": "band", "label": "Background",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "pink", "label": "Pink" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
