    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "qa",
          "settings": {
            "question": "What are the stickers actually made of?",
            "answer": "<p>Thick matte vinyl. They're waterproof, dishwasher-safe on a bottle, and they peel off cleanly if you change your mind about where you put them.</p>"
          }
        },
        "f2": {
          "type": "qa",
          "settings": {
            "question": "How quickly do you post?",
            "answer": "<p>Within two working days, first class. UK delivery is usually 1–2 days after that. Free UK shipping over £35, and yes, I post worldwide.</p>"
          }
        },
        "f3": {
          "type": "qa",
          "settings": {
            "question": "Can I request a creature?",
            "answer": "<p>Please do. Several of the categories exist because somebody messaged me asking for a snail. Tell me what you want to see.</p>"
          }
        },
        "f4": {
          "type": "qa",
          "settings": {
            "question": "Can I return something?",
            "answer": "<p>Yes — within 30 days, unused, with sticker sheets unopened. Message me first and I'll sort it out.</p>"
          }
        },
        "f5": {
          "type": "qa",
          "settings": {
            "question": "Is any of this AI?",
            "answer": "<p>No. Every drawing is made by hand on an iPad, by me, badly at first and then less badly.</p>"
          }
        }
      },
