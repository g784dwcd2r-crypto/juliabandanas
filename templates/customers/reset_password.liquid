<div class="wrap wrap--narrow" style="padding-block:48px 80px">
  <h1 class="center">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="stack-lg" style="margin-top:28px">
      <div class="field">
        <label class="field__label" for="rp-pass">{{ 'customer.login.password' | t }}</label>
        <input class="input" id="rp-pass" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="rp-conf">{{ 'customer.reset.confirm' | t }}</label>
        <input class="input" id="rp-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn btn--ink btn--full" type="submit">{{ 'customer.reset.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>
