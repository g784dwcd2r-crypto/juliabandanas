<div class="wrap wrap--narrow" style="padding-block:48px 80px">
  <h1>{{ 'customer.addresses.title' | t }}</h1>
  <p style="margin-top:12px"><a class="link" href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a></p>
  {%- for address in customer.addresses -%}
    <div class="card" style="padding:20px;margin-top:18px">
      {{ address | format_address }}
    </div>
  {%- else -%}
    <p class="muted" style="margin-top:16px">{{ 'customer.addresses.none' | t }}</p>
  {%- endfor -%}
</div>
