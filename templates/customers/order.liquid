<div class="wrap" style="padding-block:48px 80px">
  <h1>{{ order.name }}</h1>
  <p class="muted" style="margin-top:8px">{{ order.created_at | date: format: 'date' }}</p>

  <div style="margin-top:30px">
    {%- for line in order.line_items -%}
      <div class="cart-line">
        <div class="cart-line__media">
          {%- if line.image -%}<img src="{{ line.image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">{%- endif -%}
        </div>
        <div>
          <p class="cart-line__title">{{ line.title }}</p>
          {% render 'line-item-properties', properties: line.properties %}
          <div class="cart-line__foot">
            <span class="muted">&times;{{ line.quantity }}</span>
            <span class="cart-line__price">{{ line.final_line_price | money }}</span>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="cart-summary" style="margin-top:26px;max-width:380px">
    <div class="cart-summary__row"><span>{{ 'sections.cart.subtotal' | t }}</span><span>{{ order.subtotal_price | money }}</span></div>
    <div class="cart-summary__row" style="margin-top:8px"><span>{{ 'customer.order.shipping' | t }}</span><span>{{ order.shipping_price | money }}</span></div>
    <div class="cart-summary__row cart-summary__row--total"><span>{{ 'sections.cart.total' | t }}</span><span>{{ order.total_price | money }}</span></div>
  </div>
</div>
